# Local development only. Replace the sample password in your own .env.
POSTGRES_DB=sitemind
POSTGRES_USER=sitemind
POSTGRES_PASSWORD=sitemind-local
API_PORT=8000
MCP_PORT=8001
WEB_PORT=3000
# Compose-internal API address used by web, worker and mcp.
API_BASE_URL=http://api:8000

# Extraction runs only in api. Cached mode is offline and needs no credentials.
# Live mode: openai_compatible, with a JSON-mode capable model and base URL ending in /v1.
LLM_PROVIDER=cached
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Container path; a custom cache must be available inside the api image/container.
LLM_CACHE_PATH=/app/demo/extraction-cache.json

# Q&A core (#19) runs in api as an MCP client of our own mcp service.
# cached = offline replay/CI (hero questions only); decisions = OpenAI Decisions API
# (gpt-6-luna), key passed ONLY to api. The LLM only routes; answers come from the record.
QA_ROUTER_PROVIDER=cached
OPENAI_API_KEY=
# Below this routing confidence the bot asks back instead of guessing.
QA_CONFIDENCE_THRESHOLD=0.6
MCP_URL=http://mcp:8001/mcp

# Gmail inbound is opt-in. OAuth credentials are mounted ONLY into worker.
# Run the local OAuth setup documented in README; never paste tokens here.
GMAIL_ENABLED=false
# Opt in after authorizing with gmail_auth --send and setting Crew Lead test emails.
GMAIL_SEND_ENABLED=false
GMAIL_MAILBOX=
# Exact Gmail label name. Empty = dedicated project mailbox (except sent/drafts/spam/trash).
GMAIL_LABEL=INBOX
# Container path; token must be inside the worker-only .gmail mount.
GMAIL_TOKEN_FILE=/gmail/token.json
GMAIL_POLL_SECONDS=15
# Optional explicit test-sender roles, not inferred by the LLM.
GMAIL_SENDER_ROLES_JSON='{}'

# Telegram is opt-in; BOT_TOKEN is passed ONLY to worker. Disable privacy mode
# through BotFather for allowlisted demo groups. Both chat AND sender must match.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS_JSON='[]'
TELEGRAM_ALLOWED_USERS_JSON='[]'
TELEGRAM_SENDER_ROLES_JSON='{}'
TELEGRAM_SENDER_CREWS_JSON='{}'
TELEGRAM_POLL_SECONDS=2
# Shared by api + worker, not the bot token. Use a random local secret.
TELEGRAM_COMPLIANCE_KEY=
TELEGRAM_RETENTION_DAYS=7
TELEGRAM_RESPONSIBLE=SiteMind demo team
# Crew Lead record ID -> private numeric Telegram chat/user ID; otherwise Gmail.
TELEGRAM_CREW_LEADS_JSON='{}'
# Crew ID -> negative Telegram group chat ID; groups must be in TELEGRAM_ALLOWED_CHATS_JSON.
TELEGRAM_CREW_GROUPS_JSON='{}'

# Public dashboard URL in factual Flag warning emails (api only).
DASHBOARD_BASE_URL=http://localhost:3000

# Morning scan + escalation (#14). The worker triggers both via the API.
# Local site time (site timezone from the seed) when the daily scan runs; off = no
# automatic scan (replay/demo trigger POST /jobs/morning-scan with as_of instead).
MORNING_SCAN_TIME=06:00
# Seconds between automatic escalation checks; 0 = off (trigger POST /jobs/escalation).
ESCALATION_CHECK_SECONDS=300
# api only: scan covers work starting from now to the end of the day N days ahead.
SCAN_LOOKAHEAD_DAYS=1
# api only: hours without human reaction before a Flag escalates (once) to the Superintendent.
ESCALATION_HOURS=4
# api only: Superintendent team test address for escalations, approval requests and Telegram decision questions.
# Empty = missing_recipient for existing notifications; Telegram Q&A returns a retryable error instead of claiming forwarding.
SUPERINTENDENT_EMAIL=
